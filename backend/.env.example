NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://santa:santa@localhost:5433/santa?schema=public
DATABASE_URL_TEST=postgresql://santa:santa@localhost:5433/santa_test?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173
# Set true in production (cross-site frontend): cookie becomes SameSite=None; Secure
COOKIE_CROSS_SITE=false
LOG_LEVEL=info
